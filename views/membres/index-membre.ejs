<!DOCTYPE html>
<html lang="fr">

<head>
  <%- include('../partial/head', { title: 'Espace membre' }) %>
</head>

<body class="page-membre">

  <%- include('../partial/nav', { currentPage: 'dashboard' }) %>

  <section class="dashboard">

    <h1>Espace membre</h1>

    <p class="dashboard-intro">
      Accès aux contenus détaillés et à la structure complète de CAP 2032.
    </p>

    <!-- PILIERS -->
    <div class="dashboard-section">
      <h2>Les piliers</h2>

      <div class="dashboard-grid">
        <a href="../pilier1" class="dashboard-card"><img src="/archéologie/archéo.png" alt="Archéologie">Archéologie</a>
        <a href="../pilier2" class="dashboard-card"><img src="/philosophie/philosophie.png" alt="Philosophie">Philosophie</a>
        <a href="../pilier3" class="dashboard-card"><img src="/action/action.png" alt="Action">Action</a>
      </div>
    </div>

    <!-- FICHES -->
    <div class="dashboard-section">
      <h2>Fiches détaillées</h2>

      <div class="dashboard-grid">
  <% fiches.forEach((fiche) => { %>
  <a href="/membre/fiche/<%= fiche.id %>" class="dashboard-card">

    <img src="<%= fiche.image %>" alt="<%= fiche.title %>">

    <h3><%= fiche.title %></h3>

    <p><%= fiche.subtitle %></p>

  </a>
<% }) %>
      </div>
    </div>

    <!-- PROTOTYPES -->
    <div class="dashboard-section">
      <h2>Prototypes</h2>

      <div class="dashboard-grid">
        <a href="/membre/prototype1" class="dashboard-card"><img src="/action/village SCIC.png" alt="Village SCIC">Village SCIC</a>
        <a href="/membre/prototype2" class="dashboard-card"><img src="/action/polyculture élevage.png" alt="Polyculture élevage">Polyculture élevage</a>
        <a href="/membre/prototype3" class="dashboard-card"><img src="/action/école multiniveaux.png" alt="Ecole multiniveaux">Ecole multiniveaux</a>
        <a href="/membre/prototype4" class="dashboard-card"><img src="/action/synthèse.png" alt="Synthèse">Synthèse</a>
      </div>
    </div>

    <!-- SYNTHÈSE -->
    <div class="dashboard-section">
      <h2>Synthèse CAP 2032</h2>

      <div class="dashboard-grid">
        <a href="/membre/synthese" class="dashboard-card">
          Lire la synthèse
        </a>
      </div>
    </div>

  </section>

  <%- include('../partial/footer') %>

</body>
</html>
