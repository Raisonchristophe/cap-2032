<!DOCTYPE html>
<html lang="fr">

<head>
  <%- include("../partial/head", {
    title: `Fiche détaillée ${id} — ${fiche.title} — CAP2032`
  }) %>
</head>

<body class="page-fiche-detail <%= pdfMode ? 'pdf-mode' : '' %>">

  <% if (!pdfMode) { %>
    <div class="progress-bar" id="progress"></div>

    <%- include("../partial/nav", {
      currentPage: "membre"
    }) %>

    <%- include("../partial/breadcrumb", {
      items: [
        {
          label: "Accueil",
          url: "/"
        },
        {
          label: "Espace membre",
          url: "/espace-membre"
        },
        {
          label: `Fiche ${id} / 15 — ${fiche.title}`
        }
      ]
    }) %>
  <% } %>

  <main class="fiche-detail-main">

    <!-- =====================================================
         HERO
         ===================================================== -->
    <header class="fiche-hero fiche-detail-hero">
      <div class="fiche-hero-content">

        <div class="fiche-hero-topline">
          <span class="fiche-tag">
            Fiche détaillée <%= id %> / 15
          </span>

          <% if (!pdfMode) { %>
            <span class="fiche-member-badge">
              Espace membre
            </span>
          <% } %>
        </div>

        <div class="fiche-hero-grid">

          <div class="fiche-hero-text">

            <h1><%= fiche.title %></h1>

            <% if (fiche.subtitle) { %>
              <p class="fiche-subtitle">
                <%= fiche.subtitle %>
              </p>
            <% } %>

            <% if (fiche.intro) { %>
              <div class="fiche-intro">
                <% fiche.intro
                  .trim()
                  .split(/\n\s*\n/)
                  .filter(Boolean)
                  .forEach(paragraph => { %>
                    <p><%= paragraph.trim() %></p>
                <% }) %>
              </div>
            <% } %>

            <% if (!pdfMode) { %>
              <a
                href="/membre/download/fiche/<%= id %>"
                class="download-pdf"
              >
                Télécharger la fiche détaillée en PDF
              </a>
            <% } %>

          </div>

          <% if (fiche.image) { %>
            <figure class="fiche-hero-image">
              <img
                src="<%= fiche.image %>"
                alt="Illustration du pilier « <%= fiche.title %> »"
                loading="eager"
              >
            </figure>
          <% } %>

        </div>

      </div>
    </header>

    <!-- =====================================================
         SOMMAIRE AUTOMATIQUE
         ===================================================== -->
    <%
      const ficheTitles = (fiche.sections || [])
        .filter(section => section.type === "title");
    %>

    <% if (ficheTitles.length) { %>
      <nav class="fiche-structure" aria-label="Sommaire de la fiche détaillée">
        <p class="fiche-structure-title">
          Dans cette fiche
        </p>

        <ol class="structure">
          <% ficheTitles.forEach((section, index) => { %>
            <li>
              <a href="#section-<%= index + 1 %>">
                <%= section.content %>
              </a>
            </li>
          <% }) %>
        </ol>
      </nav>
    <% } %>

    <!-- =====================================================
         CONTENU
         ===================================================== -->
    <article class="fiche-body fiche-detail-body">

      <% let sectionIndex = 0; %>

      <% (fiche.sections || []).forEach(section => { %>

        <!-- TITRE -->
        <% if (section.type === "title") { %>
          <% sectionIndex += 1; %>

          <h2 id="section-<%= sectionIndex %>">
            <%= section.content %>
          </h2>
        <% } %>

        <!-- SOUS-TITRE -->
        <% if (section.type === "subtitle") { %>
          <h3>
            <%= section.content %>
          </h3>
        <% } %>

        <!-- TEXTE -->
        <% if (section.type === "text") { %>
          <div class="fiche-text">
            <% String(section.content || "")
              .trim()
              .split(/\n\s*\n/)
              .filter(Boolean)
              .forEach(paragraph => { %>
                <p><%= paragraph.trim() %></p>
            <% }) %>
          </div>
        <% } %>

        <!-- LISTE -->
        <% if (section.type === "list") { %>
          <ul class="fiche-list">
            <% (section.items || []).forEach(item => { %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        <% } %>

        <!-- CITATION -->
        <% if (section.type === "quote") { %>
          <blockquote class="pullquote">
            <p><%= section.content %></p>
          </blockquote>
        <% } %>

        <!-- ENCADRÉ -->
        <% if (section.type === "encadre") { %>
          <aside class="encadre fiche-detail-encadre">

            <% if (section.title) { %>
              <h3><%= section.title %></h3>
            <% } %>

            <div class="encadre-content">
              <% String(section.content || "")
                .trim()
                .split(/\n\s*\n/)
                .filter(Boolean)
                .forEach(paragraph => { %>
                  <p><%= paragraph.trim() %></p>
              <% }) %>
            </div>

          </aside>
        <% } %>

      <% }) %>

      <!-- ===================================================
           RESSOURCES COMPLÉMENTAIRES ÉVENTUELLES
           =================================================== -->
      <% if (fiche.links?.length) { %>
        <aside class="fiche-links">

          <span class="fiche-section-label">
            Documentation
          </span>

          <h2>Ressources complémentaires</h2>

          <ul>
            <% fiche.links.forEach(link => { %>
              <li>
                <% if (pdfMode) { %>
                  <span><%= link.label %></span>
                <% } else { %>
                  <a
                    href="<%= link.url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <%= link.label %>
                  </a>
                <% } %>
              </li>
            <% }) %>
          </ul>

        </aside>
      <% } %>

      <!-- ===================================================
           CONCLUSION ÉVENTUELLE
           =================================================== -->
      <% if (fiche.conclusion) { %>
        <div class="fiche-conclusion">
          <p><%= fiche.conclusion %></p>
        </div>
      <% } %>

    </article>

    <!-- =====================================================
         TÉLÉCHARGEMENT
         ===================================================== -->
    <% if (!pdfMode) { %>
      <section class="fiche-download-section">

        <div class="fiche-download-content">

          <span class="fiche-access-label">
            Lecture hors ligne
          </span>

          <h2>Conserver cette fiche détaillée</h2>

          <p>
            Télécharge la version complète pour la consulter,
            l’annoter ou la partager hors ligne.
          </p>

          <a
            href="/membre/download/fiche/<%= id %>"
            class="btn btn-primary download-pdf"
          >
            Télécharger le PDF
          </a>

        </div>

      </section>
    <% } %>

    <!-- =====================================================
         NAVIGATION ENTRE LES FICHES
         ===================================================== -->
    <% if (!pdfMode) { %>
      <nav
        class="content-nav rich fiche-detail-navigation"
        aria-label="Navigation entre les fiches détaillées"
      >

        <div class="content-nav-prev">
          <% if (Number(id) > 1) { %>
            <a
              href="/membre/fiche/<%= Number(id) - 1 %>"
              class="content-nav-link prev"
            >
              <span class="content-nav-dir">
                ← Fiche précédente
              </span>

              <span class="content-nav-name">
                Fiche <%= Number(id) - 1 %>
              </span>
            </a>
          <% } %>
        </div>

        <div class="content-nav-list">
          <a
            href="/espace-membre"
            class="content-nav-link list"
          >
            <span class="content-nav-dir">
              ↑ Retour
            </span>

            <span class="content-nav-name">
              Espace membre
            </span>
          </a>
        </div>

        <div class="content-nav-next">
          <% if (Number(id) < 15) { %>
            <a
              href="/membre/fiche/<%= Number(id) + 1 %>"
              class="content-nav-link next"
            >
              <span class="content-nav-dir">
                Fiche suivante →
              </span>

              <span class="content-nav-name">
                Fiche <%= Number(id) + 1 %>
              </span>
            </a>
          <% } %>
        </div>

      </nav>
    <% } %>

  </main>

  <% if (!pdfMode) { %>
    <%- include("../partial/footer") %>

    <script>
      const progress = document.getElementById("progress");

      if (progress) {
        const updateProgress = () => {
          const scrollableHeight =
            document.documentElement.scrollHeight -
            window.innerHeight;

          const percentage =
            scrollableHeight > 0
              ? (window.scrollY / scrollableHeight) * 100
              : 0;

          progress.style.width =
            `${Math.min(100, percentage)}%`;
        };

        window.addEventListener(
          "scroll",
          updateProgress,
          { passive: true },
        );

        updateProgress();
      }
    </script>
  <% } %>

</body>
</html>
