  <!-- DÉMARCHE -->
  <section class="demarche" id="demarche">
    <div class="demarche-inner">
      <div class="demarche-text reveal">
        <h2>Ce site est une synthèse ouverte.</h2>
        <p>CAP2032 est une plateforme de réflexion et de propositions.
          Elle s'enrichit progressivement d'articles, de travaux historiques,
          de prototypes territoriaux et de nouvelles analyses.
          Elle ne prétend pas apporter des réponses définitives,
          mais proposer un cadre cohérent pour nourrir le débat et expérimenter des solutions.</p>

      <div class="demarche-aside reveal" style="transition-delay:0.2s">
        <span class="demarche-aside-label">Vous trouverez ici</span>
        <ul class="demarche-list">
          <li>• Les publications (livre, essais, articles)</li>
          <li>• Les fiches Histoire & Archéologie</li>
          <li>• Les 15 fiches stratégiques</li>
          <li>• Les 4 prototypes territoriaux</li>
          <li>• Les ressources documentaires</li>
          <li>• Les futures plateformes collaboratives</li>
        </ul>
      </div>
    </div>
  </section>

 <!-- FOOTER -->
<%- include("partial/footer") %>

  <script>
    // Scroll reveal
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

    reveals.forEach(el => observer.observe(el));
  </script>

</body>
