        </span>

        <h3>
          Construire l’avenir
        </h3>

        <p>
          Fiches stratégiques, prototypes et expérimentations territoriales.
        </p>

        <span class="dashboard-card-link">
          Explorer le pilier →
        </span>

      </div>

    </a>

  </div>

</section>


<!-- PUBLICATIONS -->
<section class="dashboard-section dashboard-publications">

  <div class="dashboard-section-header">

    <span class="dashboard-section-eyebrow">
      Publications
    </span>

    <h2>
      Le livre et les essais
    </h2>

    <p>
      Découvrir les publications longues qui présentent la vision
      d’ensemble de CAP2032 et les réflexions philosophiques qui
      accompagnent sa construction.
    </p>

  </div>

  <div class="dashboard-grid dashboard-grid-two">

    <!-- LIVRE CAP2032 -->
    <a
      href="/membre/livre"
      class="dashboard-card dashboard-publication-card"
    >

      <img
        src="/logo/accueil.png"
        alt="Le livre CAP2032"
      >

      <div class="dashboard-card-content">

        <span class="dashboard-card-number">
          Livre
        </span>

        <h3>
          CAP2032 — Sauvons la France
        </h3>

        <p>
          Une vision systémique du redressement national, articulant
          les quinze fiches stratégiques et leur déclinaison territoriale.
        </p>

        <span class="dashboard-card-link">
          Accéder au livre →
        </span>

      </div>

    </a>


    <!-- ESSAIS PHILOSOPHIQUES -->
    <a
      href="/membre/essais"
      class="dashboard-card dashboard-publication-card"
    >

      <img
        src="/philosophie/vignette philosophie.png"
        alt="Essais philosophiques de CAP2032"
      >

      <div class="dashboard-card-content">

        <span class="dashboard-card-number">
          Essais
        </span>

        <h3>
          Essais philosophiques
        </h3>

        <p>
          Des réflexions sur l’intérêt général, les libertés,
          la coopération, les institutions et les conditions
          d’une société réellement gouvernable.
        </p>

        <span class="dashboard-card-link">
          Lire les essais →
        </span>

      </div>

    </a>

  </div>

</section>


<!-- FICHES DÉTAILLÉES -->
<section class="dashboard-section">

  <div class="dashboard-section-header">

    <span class="dashboard-section-eyebrow">
      Trajectoire nationale
    </span>

    <h2>
      Les quinze fiches détaillées
    </h2>

    <p>
      Chaque fiche approfondit un domaine stratégique et présente
      le constat, les objectifs, les verrous, le cadre et les actions
      proposées.
    </p>

  </div>

  <% if (
    typeof fiches !== "undefined" &&
    fiches.length > 0
  ) { %>

    <div class="dashboard-grid">

      <% fiches.forEach((fiche) => { %>

        <a
          href="/membre/fiche/<%= fiche.id %>"
          class="dashboard-card"
        >

          <% if (fiche.image) { %>

            <img
              src="<%= fiche.image %>"
              alt="<%= fiche.title %>"
              loading="lazy"
            >

          <% } %>

          <div class="dashboard-card-content">

            <span class="dashboard-card-number">
              Fiche <%= String(fiche.id).padStart(2, "0") %>
            </span>

            <h3>
              <%= fiche.title %>
            </h3>

            <% if (fiche.subtitle) { %>

              <p>
                <%= fiche.subtitle %>
              </p>

            <% } %>

            <span class="dashboard-card-link">
              Consulter la fiche →
            </span>

          </div>

        </a>

      <% }) %>

    </div>

  <% } else { %>

    <p class="dashboard-empty">
      Aucune fiche détaillée n’est encore disponible.
    </p>

  <% } %>

</section>


<!-- PROTOTYPES -->
<section class="dashboard-section">

  <div class="dashboard-section-header">

    <span class="dashboard-section-eyebrow">
