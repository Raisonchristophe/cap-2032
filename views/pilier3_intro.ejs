<%- include ('partial/footer') %>

  <script>
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.06, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(el => observer.observe(el));

    const showMorePrototypesButton = document.getElementById(
  "show-more-prototypes"
);

if (showMorePrototypesButton) {
  showMorePrototypesButton.addEventListener("click", () => {
    const hiddenPrototypes = Array.from(
      document.querySelectorAll(
        "[data-prototype-card].prototype-hidden"
      )
    );

    hiddenPrototypes.slice(0, 2).forEach((card) => {
      card.classList.remove("prototype-hidden");
      card.classList.add("visible");
    });

    const remainingPrototypes = document.querySelectorAll(
      "[data-prototype-card].prototype-hidden"
    );

    if (remainingPrototypes.length === 0) {
      showMorePrototypesButton.hidden = true;
    }
  });
}
  </script>

</body>
