        </p>

        <span class="dashboard-card-link">
          Explorer le pilier →
        </span>

      </div>

    </a>


    <a href="/pilier3" class="dashboard-card">

      <img
        src="/action/action.png"
        alt="Propositions et expérimentations"
      >

      <div class="dashboard-card-content">

        <span class="dashboard-card-number">
