<!DOCTYPE html>
<html lang="fr">

<head>

  <%- include("partial/head", {
    title: "Archives — CAP2032"
  }) %>

</head>

<body class="page-ressources page-archives">

  <!-- NAVIGATION -->
  <%- include("partial/nav", {
    currentPage: "ressources"
  }) %>


  <!-- FIL D’ARIANE -->
  <%- include("partial/breadcrumb", {
    items: [
      {
        label: "Accueil",
        url: "/"
      },
      {
        label: "Archives"
      }
    ]
  }) %>


  <!-- HERO -->
  <section class="archives-hero">

    <div class="archives-hero-inner">

      <span class="archives-eyebrow">
        Bibliothèque de CAP2032
      </span>

      <h1>
        Archives des<br>
        <em>publications</em>
      </h1>

      <p>
        Retrouvez l’ensemble des articles de réflexion et des publications
        consacrées à l’histoire, à l’archéologie, à l’anthropologie et à
        la paléogénétique.
      </p>

    </div>

  </section>


  <!-- COMPTEURS -->
  <section class="archives-stats">

    <div class="archives-stats-inner">

      <div class="archives-stat">

        <span
          class="archives-stat-value"
          id="archives-total"
        >
          <%= publicationsArchives.length %>
        </span>

        <span class="archives-stat-label">
          Publications
        </span>

      </div>

      <div class="archives-stat">

        <span
          class="archives-stat-value"
          id="archives-archeologie"
        >
          <%= publicationsArchives.filter(
            publication =>
              publication.type === "archeologie"
          ).length %>
        </span>

        <span class="archives-stat-label">
          Histoire &amp; Archéologie
        </span>

      </div>

      <div class="archives-stat">

        <span
          class="archives-stat-value"
          id="archives-articles"
        >
          <%= publicationsArchives.filter(
            publication =>
              publication.type === "article"
          ).length %>
        </span>

        <span class="archives-stat-label">
          Articles de réflexion
        </span>

      </div>

    </div>

  </section>


  <!-- RECHERCHE ET FILTRES -->
  <section class="archives-controls">

    <div class="archives-controls-inner">

      <div class="archives-search">

        <label
          for="archives-search-input"
          class="sr-only"
        >
          Rechercher une publication
        </label>

        <input
          type="search"
          id="archives-search-input"
          placeholder="Rechercher un titre, un thème ou un mot-clé…"
          autocomplete="off"
        >

      </div>

      <div
        class="archives-filters"
        role="group"
        aria-label="Filtrer les publications"
      >

        <button
          type="button"
          class="archives-filter active"
          data-filter="all"
        >
          Toutes
        </button>

        <button
          type="button"
          class="archives-filter"
          data-filter="archeologie"
        >
          Histoire &amp; Archéologie
        </button>

        <button
          type="button"
          class="archives-filter"
          data-filter="article"
        >
          Réflexions
        </button>

      </div>

      <div class="archives-sort">

        <label for="archives-sort-select">
          Trier
        </label>

        <select id="archives-sort-select">

          <option value="recent">
            Plus récentes
          </option>

          <option value="oldest">
            Plus anciennes
          </option>

          <option value="alphabetical">
            Ordre alphabétique
          </option>

        </select>

      </div>

    </div>

  </section>


  <!-- RÉSULTATS -->
  <section class="archives-results">

    <div class="archives-results-inner">

      <div class="archives-results-header">

        <p id="archives-count-label">
          <%= publicationsArchives.length %>
          publication<%= publicationsArchives.length > 1 ? "s" : "" %>
        </p>

      </div>


      <% if (publicationsArchives.length > 0) { %>

        <div
          class="archives-grid"
          id="archives-grid"
        >

          <% publicationsArchives.forEach(
            (publication, index) => {
          %>

            <article
              class="archive-card reveal"
              data-archive-card
              data-type="<%= publication.type %>"
              data-title="<%= publication.title.toLowerCase() %>"
              data-date="<%= publication.publishedAt || `${publication.publicationYear || 0}-01-01` %>"
              data-index="<%= index %>"
              data-search="<%=
                [
                  publication.title,
                  publication.subtitle,
                  publication.excerpt,
                  publication.category,
                  publication.collection,
                  ...(publication.tags || [])
                ]
                  .filter(Boolean)
                  .join(' ')
                  .toLowerCase()
              %>"
            >

              <% if (publication.image) { %>

                <a
                  href="/publication/<%= publication.slug %>"
                  class="archive-card-image"
                  aria-label="Lire « <%= publication.title %> »"
                >

                  <img
                    src="<%= publication.image %>"
                    alt="Illustration de « <%= publication.title %> »"
                    loading="lazy"
                  >

                </a>

              <% } %>


              <div class="archive-card-content">

                <div class="archive-card-meta">

                  <span
                    class="archive-card-type <%= publication.type %>"
                  >
                    <% if (
                      publication.type === "archeologie"
                    ) { %>

                      Histoire &amp; Archéologie

                    <% } else { %>

                      Réflexion

                    <% } %>
                  </span>


                  <% if (publication.publicationYear) { %>

                    <span class="archive-card-year">
                      <%= publication.publicationYear %>
                    </span>

                  <% } %>

                </div>


                <% if (publication.category) { %>

                  <span class="archive-card-category">
                    <%= publication.category %>
                  </span>

                <% } %>


                <h2 class="archive-card-title">

                  <a href="/publication/<%= publication.slug %>">
                    <%= publication.title %>
                  </a>

                </h2>


                <% if (publication.subtitle) { %>

                  <p class="archive-card-subtitle">
                    <%= publication.subtitle %>
                  </p>

                <% } %>


                <% if (publication.excerpt) { %>

                  <p class="archive-card-excerpt">
                    <%= publication.excerpt %>
                  </p>

                <% } %>


                <% if (
                  publication.tags &&
                  publication.tags.length > 0
                ) { %>

                  <div class="archive-card-tags">

                    <% publication.tags
                      .slice(0, 3)
                      .forEach(tag => {
                    %>

                      <span class="archive-card-tag">
                        <%= tag %>
                      </span>

                    <% }) %>

                  </div>

                <% } %>


                <a
                  href="/publication/<%= publication.slug %>"
                  class="archive-card-link"
                >
                  Lire la publication
                  <span aria-hidden="true">→</span>
                </a>

              </div>

            </article>

          <% }) %>

        </div>


        <div
          class="archives-more"
          id="archives-more-container"
        >

          <button
            type="button"
            class="btn-secondary"
            id="archives-more-button"
          >
            Afficher les publications suivantes
          </button>

        </div>

      <% } else { %>

        <p class="archives-empty">
          Aucune publication n’est encore disponible.
        </p>

      <% } %>


      <p
        class="archives-empty"
        id="archives-no-result"
        hidden
      >
        Aucune publication ne correspond à cette recherche.
      </p>

    </div>

  </section>


  <!-- FOOTER -->
  <%- include("partial/footer") %>


  <script>

    const searchInput =
      document.getElementById("archives-search-input");

    const sortSelect =
      document.getElementById("archives-sort-select");

    const filterButtons =
      document.querySelectorAll("[data-filter]");

    const grid =
      document.getElementById("archives-grid");

    const countLabel =
      document.getElementById("archives-count-label");

    const noResult =
      document.getElementById("archives-no-result");

    const moreButton =
      document.getElementById("archives-more-button");

    const moreContainer =
      document.getElementById("archives-more-container");

    let currentFilter = "all";
    let visibleLimit = 6;


    function getCards() {
      return Array.from(
        document.querySelectorAll("[data-archive-card]")
      );
    }


    function sortCards(cards) {

      const sortValue = sortSelect
        ? sortSelect.value
        : "recent";

      return cards.sort((cardA, cardB) => {

        if (sortValue === "alphabetical") {

          return cardA.dataset.title.localeCompare(
            cardB.dataset.title,
            "fr"
          );

        }

        const dateA =
          new Date(cardA.dataset.date).getTime();

        const dateB =
          new Date(cardB.dataset.date).getTime();

        if (sortValue === "oldest") {
          return dateA - dateB;
        }

        return dateB - dateA;

      });

    }


    function updateArchives() {

      if (!grid) {
        return;
      }

      const searchValue = searchInput
        ? searchInput.value.trim().toLowerCase()
        : "";

      const matchingCards = getCards().filter(card => {

        const matchesType =
          currentFilter === "all" ||
          card.dataset.type === currentFilter;

        const matchesSearch =
          !searchValue ||
          card.dataset.search.includes(searchValue);

        return matchesType && matchesSearch;

      });

      const sortedCards =
        sortCards(matchingCards);

      getCards().forEach(card => {
        card.hidden = true;
      });

      sortedCards.forEach((card, index) => {

        grid.appendChild(card);

        card.hidden = index >= visibleLimit;

        if (!card.hidden) {
          card.classList.add("visible");
        }

      });

      const total = matchingCards.length;

      countLabel.textContent =
        `${total} publication${total > 1 ? "s" : ""}`;

      noResult.hidden = total !== 0;

      if (moreContainer) {

        moreContainer.hidden =
          total <= visibleLimit;

      }

    }


    filterButtons.forEach(button => {

      button.addEventListener("click", () => {

        filterButtons.forEach(item => {
          item.classList.remove("active");
        });

        button.classList.add("active");

        currentFilter =
          button.dataset.filter;

        visibleLimit = 6;

        updateArchives();

      });

    });


    if (searchInput) {

      searchInput.addEventListener("input", () => {
        visibleLimit = 6;
        updateArchives();
      });

    }


    if (sortSelect) {

      sortSelect.addEventListener("change", () => {
        visibleLimit = 6;
        updateArchives();
      });

    }


    if (moreButton) {

      moreButton.addEventListener("click", () => {
        visibleLimit += 6;
        updateArchives();
      });

    }


    updateArchives();

  </script>

</body>
</html>
