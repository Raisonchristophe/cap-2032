    alt="CAP2032"
    class="nav-logo-img"
  >
</a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label="Ouvrir le menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-menu" id="site-nav-menu">

      <ul class="nav-links">

        <li>
          <a
            href="/pilier1"
            class="<%= currentPage === 'pilier1' ? 'active' : '' %>"
          >
            Histoire & Archéologie
          </a>
        </li>

        <li>
          <a
            href="/pilier2"
            class="<%= currentPage === 'pilier2' ? 'active' : '' %>"
          >
            Réflexions
          </a>
        </li>

        <li>
          <a
            href="/pilier3"
            class="<%= currentPage === 'pilier3' ? 'active' : '' %>"
          >
            Action
          </a>
        </li>



        <li>
          <a
            href="/ressources"
            class="<%= currentPage === 'ressources' ? 'active' : '' %>"
          >
            Archives
          </a>
        </li>

        <li>
          <a
            href="/contact"
            class="<%= currentPage === 'contact' ? 'active' : '' %>"
          >
            Contact
          </a>
        </li>

      </ul>

      <div class="nav-account">

        <% if (user) { %>

          <a
            href="/espace-membre"
            class="nav-member <%= currentPage === 'membre' ? 'active' : '' %>"
          >
            Espace membre
          </a>

          <a href="/logout" class="nav-logout">
            Déconnexion
          </a>

        <% } else { %>

          <a href="/login" class="nav-member">
            Connexion
          </a>

        <% } %>

      </div>

    </div>

  </div>

</nav>

<script>
  const navToggle = document.querySelector(".nav-toggle");
  const navMenu = document.querySelector(".nav-menu");

  if (navToggle && navMenu) {
    navToggle.addEventListener("click", () => {
      const isOpen =
        navToggle.getAttribute("aria-expanded") === "true";

      navToggle.setAttribute(
        "aria-expanded",
        String(!isOpen),
      );

      navMenu.classList.toggle("is-open");
    });
  }
</script>
